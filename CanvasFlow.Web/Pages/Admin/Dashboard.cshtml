@page
@model CanvasFlow.Web.Pages.Admin.DashboardModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Admin Dashboard";
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin-common.css"asp-append-version="true" />

<div class="admin-dashboard-container">
    <!-- Top Navigation Bar -->
    <nav class="admin-top-nav">
        <div class="admin-top-nav-left">
            <h2 class="admin-logo">Admin Portal</h2>
        </div>
        <div class="admin-top-nav-right">
            <a asp-page="/Admin/Dashboard" class="admin-nav-link active">
                <span class="icon">🏠</span> Dashboard
            </a>
            <a asp-page="/Admin/Profile" class="admin-nav-link">
                <span class="icon">👤</span> Admin Profile
            </a>
        </div>
    </nav>

    <div class="glass-card admin-main-card">
        <div class="admin-header">
            <h1 class="admin-title">Admin Control Panel</h1>
            <p class="admin-subtitle">Manage users, content and system logs</p>
        </div>

        <!-- Custom Navigation inspired by Profile Sidebar -->
        <div class="admin-nav-group">
            <button class="admin-nav-btn active" id="btn-users" onclick="switchTab('users')">
                <span class="icon">👥</span> User Moderation
            </button>
            <button class="admin-nav-btn" id="btn-content" onclick="switchTab('content')">
                <span class="icon">📝</span> Content Management
            </button>
            <button class="admin-nav-btn" id="btn-audit" onclick="switchTab('audit')">
                <span class="icon">📜</span> Audit Logs
            </button>
        </div>

        <div class="admin-content-area">
            <!-- Users Moderation Section -->
            <div id="section-users" class="admin-tab-section active">
                <div class="glass-table-wrapper">
                    <table class="admin-table" id="usersTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>User</th>
                                <th>Status</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Loaded via JS -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Content Management Section -->
            <div id="section-content" class="admin-tab-section">
                <div class="glass-table-wrapper">
                    <table class="admin-table" id="contentTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Status</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Loaded via JS -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Audit Logs Section -->
            <div id="section-audit" class="admin-tab-section">
                <div class="glass-table-wrapper">
                    <table class="admin-table" id="auditTable">
                        <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>Admin</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Loaded via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
