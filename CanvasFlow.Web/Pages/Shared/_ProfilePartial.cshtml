@model CanvasFlow.Web.Pages.UserProfileDto

<div class="profile-card-wrapper">
    <div class="glass-card" id="profile-card">

        <!-- ── Avatar + Name ── -->
        <div class="profile-header">
            <div class="avatar" id="avatar-display">
                @Model.Username.Substring(0, 1).ToUpper()
            </div>
            <h2 class="profile-name" id="display-username">@Model.Username</h2>
            <p class="profile-role">@Model.Role</p>

            <!-- Stats row -->
            <div class="profile-stats-row">
                <div class="profile-stat">
                    <span class="stat-value" id="stat-publications">@Model.PublicationCount</span>
                    <span class="stat-label">Posts</span>
                </div>
                <div class="profile-stat" style="border-left:1px solid rgba(255,255,255,0.1); border-right:1px solid rgba(255,255,255,0.1); padding:0 20px;">
                    <span class="stat-value">
                        <span class="status-badge @Model.AccountStatus.ToLower()">@Model.AccountStatus</span>
                    </span>
                    <span class="stat-label">Status</span>
                </div>
                <div class="profile-stat">
                    <span class="stat-value" style="font-size:0.85rem; word-break:break-all;">@Model.Email.Split('@')[0]</span>
                    <span class="stat-label">Account</span>
                </div>
            </div>
        </div>

        <!-- ── View Mode (details) ── -->
        <div id="profile-view-mode">
            <div class="profile-details">
                <div class="detail-item">
                    <label>Email Address</label>
                    <p>@Model.Email</p>
                </div>
                <div class="detail-item" style="border:none; margin:0; padding:0;">
                    <label>Member since</label>
                    <p style="opacity:0.7; font-size:0.88rem;">CanvasFlow Community</p>
                </div>
            </div>
        </div>

        <!-- ── Edit Mode ── -->
        <div id="profile-edit-mode" style="display: none;">
            <div class="custom-form">
                <div class="form-group">
                    <label for="edit-username">Username</label>
                    <input type="text" id="edit-username" class="form-control" value="@Model.Username" />
                </div>
                <div class="profile-actions-container" style="margin-top: 16px; display: flex; gap: 10px;">
                    <button type="button" id="btn-save-profile" class="btn-submit" style="flex:1;">Save</button>
                    <button type="button" id="btn-cancel-profile" class="btn-submit" style="flex:1; background: rgba(255,255,255,0.08); color: var(--text-color); box-shadow:none;">Cancel</button>
                </div>
            </div>
        </div>

        <!-- ── Navigation Links ── -->
        <div class="profile-links">
            <a href="#" id="btn-edit-profile" class="btn-link nav-link" data-section="Management">
                <span class="nav-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                    </svg>
                </span>
                <span class="nav-label">Manage Profile</span>
            </a>

            <a href="#" class="btn-link nav-link" data-section="Messages">
                <span class="nav-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                </span>
                <span class="nav-label">Messages</span>
            </a>

            <a href="#" class="btn-link nav-link" data-section="Notifications">
                <span class="nav-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                </span>
                <span class="nav-label">Notifications</span>
            </a>

            <a href="#" class="btn-link nav-link" data-section="Publications">
                <span class="nav-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
                    </svg>
                </span>
                <span class="nav-label">My Publications</span>
            </a>

            <a href="#" class="btn-link nav-link active-link" data-section="Feed" id="feed-link">
                <span class="nav-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.54C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
                    </svg>
                </span>
                <span class="nav-label">Community Feed</span>
            </a>
        </div>

        <!-- ── Logout ── -->
        <div class="profile-actions">
            <form method="post" asp-page-handler="Logout">
                <button type="submit" id="btn-logout" class="btn-logout">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                    Sign Out
                </button>
            </form>
        </div>

    </div>
</div>
