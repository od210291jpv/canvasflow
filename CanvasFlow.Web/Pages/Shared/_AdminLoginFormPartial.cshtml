@model CanvasFlow.Web.Pages.Admin.LoginModel

<form id="admin-login-form" method="post" asp-page-handler="Login">
    <div class="form-group">
        <label asp-for="LoginData.Username">Username</label>
        <div class="input-wrapper">
            <input asp-for="LoginData.Username"
                   id="admin-username"
                   class="form-control"
                   type="text"
                   placeholder="Enter admin username"
                   required
                   autocomplete="username" />
            <span class="input-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
            </span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="LoginData.Password">Password</label>
        <div class="input-wrapper">
            <input asp-for="LoginData.Password"
                   id="admin-password"
                   class="form-control"
                   type="password"
                   placeholder="Enter admin password"
                   required
                   autocomplete="current-password" />
            <span class="input-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
            </span>
        </div>
    </div>

    <button type="submit" class="btn-submit admin-login-btn" id="login-btn">
        <span class="btn-text">Sign In to Admin</span>
        <span class="btn-loader" style="display: none;">
            <svg class="spinner" width="18" height="18" viewBox="0 0 50 50">
                <circle cx="25" cy="25" r="20" fill="none" stroke-width="5"
                        stroke-linecap="round" stroke-dasharray="80, 200"
                        stroke="#0f0c29">
                    <animateTransform attributeName="transform" type="rotate"
                                      from="0 25 25" to="360 25 25"
                                      dur="1s" repeatCount="indefinite"/>
                </circle>
            </svg>
        </span>
    </button>
</form>
