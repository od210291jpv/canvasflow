<link rel="stylesheet" href="~/css/tag-filter.css">
<div id="feed-container">
    <div class="glass-card feed-card">
        <h3 id="feed-title">Welcome to the Community Feed</h3>
        
        <div id="tag-filter-container" class="tag-filter-container">
            <span class="filter-label">Filter by:</span>
            <div id="tag-chips" class="tag-chips">
                <!-- Tags will be populated here dynamically -->
                <button class="tag-chip active" data-tag="">All</button>
            </div>
        </div>

        <div id="feed-content">
            <p class="placeholder-text">Loading the latest community activity...</p>
        </div>
        <div id="pagination-controls" class="pagination-controls"></div>
    </div>
</div>
