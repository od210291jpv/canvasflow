@page
@model CanvasFlow.Web.Pages.AuthModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "CanvasFlow — Sign In";
}
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="auth-container">

    <!-- ══ LEFT: Branding panel ══ -->
    <div class="auth-brand-panel">
        <div class="auth-brand-logo">
            <div class="auth-brand-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
            </div>
            <span class="auth-brand-name">CanvasFlow</span>
        </div>

        <p class="auth-brand-tagline">
            Where creativity<br><span>flows freely</span>
        </p>

        <p class="auth-brand-desc">
            Join a community of artists, creators, and storytellers sharing their work, ideas, and inspiration.
        </p>

        <div class="auth-feature-list">
            <div class="auth-feature-item">
                <span class="auth-feature-dot"></span>
                Share artwork &amp; media with the community
            </div>
            <div class="auth-feature-item">
                <span class="auth-feature-dot"></span>
                Discover and explore creative feeds
            </div>
            <div class="auth-feature-item">
                <span class="auth-feature-dot"></span>
                Connect and message other creators
            </div>
        </div>
    </div>

    <!-- ══ RIGHT: Form panel ══ -->
    <div class="glass-card">

        <div class="auth-form-header">
            <h1 class="auth-form-title">@(Model.IsLoginMode ? "Welcome back" : "Create account")</h1>
            <p class="auth-form-subtitle">@(Model.IsLoginMode ? "Sign in to your CanvasFlow account" : "Join the CanvasFlow community today")</p>
        </div>

        <div class="auth-tabs">
            <a class="tab-btn @(Model.IsLoginMode ? "active" : "")"
               asp-page="/Auth" asp-route-loginMode="true">Sign In</a>
            <a class="tab-btn @(!Model.IsLoginMode ? "active" : "")"
               asp-page="/Auth" asp-route-loginMode="false">Register</a>
        </div>

        <div class="auth-content">
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert @(Model.IsError ? "alert-error" : "alert-success")">
                    @if (Model.IsError)
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    }
                    @Model.Message
                </div>
            }

            @if (Model.IsLoginMode)
            {
                <form id="login-form">
                    <div class="form-group has-icon">
                        <label asp-for="LoginData.Username">Username</label>
                        <div class="input-wrapper">
                            <input asp-for="LoginData.Username" id="login-username" class="form-control"
                                   placeholder="Enter your username" required autocomplete="username" />
                            <span class="input-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                                </svg>
                            </span>
                        </div>
                    </div>
                    <div class="form-group has-icon">
                        <label asp-for="LoginData.Password">Password</label>
                        <div class="input-wrapper">
                            <input asp-for="LoginData.Password" id="login-password" type="password" class="form-control"
                                   placeholder="Enter your password" required autocomplete="current-password" />
                            <span class="input-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                </svg>
                            </span>
                        </div>
                    </div>
                    <button type="submit" class="btn-submit">Sign In</button>
                    <div id="login-status" class="alert" style="display: none; margin-top: 15px;"></div>
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="Register">
                    <div class="form-group has-icon">
                        <label asp-for="RegisterData.Username">Username</label>
                        <div class="input-wrapper">
                            <input asp-for="RegisterData.Username" class="form-control"
                                   placeholder="Choose a username" required autocomplete="username" />
                            <span class="input-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                                </svg>
                            </span>
                        </div>
                    </div>
                    <div class="form-group has-icon">
                        <label asp-for="RegisterData.Email">Email</label>
                        <div class="input-wrapper">
                            <input asp-for="RegisterData.Email" type="email" class="form-control"
                                   placeholder="Enter your email" required autocomplete="email" />
                            <span class="input-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                                </svg>
                            </span>
                        </div>
                    </div>
                    <div class="form-group has-icon">
                        <label asp-for="RegisterData.Password">Password</label>
                        <div class="input-wrapper">
                            <input asp-for="RegisterData.Password" type="password" class="form-control"
                                   placeholder="Create a password" required autocomplete="new-password" />
                            <span class="input-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                </svg>
                            </span>
                        </div>
                    </div>
                    <button type="submit" class="btn-submit">Create Account</button>
                </form>
            }
        </div>

    </div>
</div>

<script src="~/js/auth.js" asp-append-version="true"></script>
