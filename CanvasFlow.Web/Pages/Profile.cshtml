@page
@model CanvasFlow.Web.Pages.ProfileModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "User Profile";
}
<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<div class="profile-layout-container">
    @if (Model.IsError)
    {
        <div class="profile-card-wrapper">
            <div class="glass-card">
                <div class="alert alert-error">
                    @Model.ErrorMessage
                </div>
                <div class="profile-actions">
                    <form method="post" asp-page-handler="Logout">
                       <button type="submit" id="btn-logout" class="btn-logout">Logout</button>
                    </form>
                </div>
            </div>
        </div>
    }
    else if (Model.UserProfile != null)
    {
        <partial name="_ProfilePartial" model="Model.UserProfile" />
    }

    <div class="active-sections-placeholder">
        <partial name="_MessagesPartial" />
        <partial name="_FeedPartial" />
        <partial name="_PlaceholderPartial" />
        <partial name="_PublicationsPartial" />
    </div>
</div>

<partial name="_ModalsPartial" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<div id="user-metadata" data-user-id="@(Model.UserProfile?.Id ?? 0)">
</div>

<script src="~/js/profile.js" asp-append-version="true"></script>
<script src="~/js/logout-handler.js" asp-append-version="true"></script>
